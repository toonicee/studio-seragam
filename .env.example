# Supabase Configuration (konfigurator, opsional)
# Dapatkan kredensial ini di Dashboard Supabase: Project Settings -> API
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Toko merchandise (/shop) ──
# Domain toko di VPS (dipakai docker-compose & Caddy untuk HTTPS otomatis)
SHOP_DOMAIN=shop.indahexpres.com
# Folder database SQLite dan file unggahan (foto produk, QRIS, bukti bayar). Di Docker otomatis /data
DATA_DIR=./data
# Alamat publik untuk login admin. Di Docker otomatis https://SHOP_DOMAIN; kosongkan saat `npm run dev`
# ORIGIN=https://shop.indahexpres.com
# String acak minimal 32 karakter, mis. hasil: openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Admin pertama dibuat otomatis saat database belum punya admin
ADMIN_EMAIL=admin@indahexpres.com
ADMIN_PASSWORD=ganti-kata-sandi-ini
# 1 = isi katalog contoh saat database masih kosong
SEED_SAMPLE=1
# 1 = tambahkan mitra & pesanan contoh untuk melihat progres PO (jangan dipakai di server asli)
SEED_DEMO_ORDERS=0
