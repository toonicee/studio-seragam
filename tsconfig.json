{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"ignoreDeprecations": "6.0",
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.js",
		"src/**/*.svelte",
		"vite.config.ts"
	]
}
